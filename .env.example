# Firebase Configuration Environment Variables
# Copy this file to .env and replace the values with your Firebase Project Settings.
# If omitted or left as placeholders, the application runs seamlessly in DEMO MODE (Local Persistent Storage).

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=smart-parking-management.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=smart-parking-management
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=smart-parking-management.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:android:abcdef1234567890
