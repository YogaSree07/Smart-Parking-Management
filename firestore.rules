rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.admin == true);
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Parking Areas Collection
    match /parkingAreas/{parkingId} {
      // Anyone authenticated can view facilities
      allow read: if isAuthenticated();
      // Only administrators can add, update, or remove parking areas
      allow create, update, delete: if isAdmin();
    }

    // Parking Slots Collection
    match /parkingSlots/{slotId} {
      allow read: if isAuthenticated();
      // Only admins can change slot status / maintenance
      allow write: if isAdmin();
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      // Users can read their own bookings; Admins can read all bookings
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Users can create bookings if authenticated and assigned to themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Users can cancel their own bookings; Admins can verify or complete
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
